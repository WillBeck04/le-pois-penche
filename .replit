# Replit config. Import the GitHub repo and press Run; Deploy uses the [deployment] block.
# Run (workspace preview, used by Replit Agent): dev server with live reload.
# Deploy (the public site): clean install, production build (also writes sitemap.xml + robots.txt), then next start.
# Do not set NODE_ENV=production here: npm would skip devDependencies (Tailwind, TypeScript) and the build would fail.
run = "npm install && npm run dev -- -p 3000 -H 0.0.0.0"
entrypoint = "app/[lang]/page.tsx"
modules = ["nodejs-20"]

[nix]
channel = "stable-24_05"

[deployment]
build = ["sh", "-c", "npm ci && npm run build"]
run = ["sh", "-c", "npm start"]
deploymentTarget = "autoscale"

[[ports]]
localPort = 3000
externalPort = 80
